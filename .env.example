# ============================================
# 로컬 개발: 그대로 복사하여 사용 (cp .env.example .env)
# AWS 배포: 아래 값을 프로덕션 환경에 맞게 수정
# ============================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biddo
DB_USERNAME=biddo
DB_PASSWORD=biddo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ELASTICSEARCH_URI=http://localhost:9200

